#X text 200 240 -- 4 Ethiopian voices: pluck \, bow \, flute \, drum;
#N canvas 0 0 900 600 router 0;
#X obj 20 30 inlet voice;
#X obj 20 60 inlet bus;
#X obj 20 90 inlet level;
#X text 250 30 16-channel patchbay matrix \, send_<v>_<b> in [0..1];
#X obj 20 150 send~ bus_dry;
#X obj 100 150 send~ bus_rev;
#X obj 180 150 send~ bus_del;
#X obj 260 150 send~ bus_dest3;
#X restore 600 240 pd router;
#X text 200 280 -- multiplied qubit drives sends from each voice to each bus;
#X obj 20 410 r gate_0;
#X obj 80 410 r pitch_0;
#X obj 20 440 r gate_1;
#X obj 80 440 r pitch_1;
#X obj 20 470 r gate_2;
#X obj 80 470 r pitch_2;
#X obj 20 500 r gate_3;
#X obj 80 500 r pitch_3;
#X obj 20 540 r send_0_0;
#X obj 80 540 r send_0_1;
#X obj 140 540 r send_0_2;
#X obj 200 540 r send_0_3;
#X obj 20 570 r send_1_0;
#X obj 80 570 r send_1_1;
#X obj 140 570 r send_1_2;
#X obj 200 570 r send_1_3;
#X obj 20 600 r send_2_0;
#X obj 80 600 r send_2_1;
#X obj 140 600 r send_2_2;
#X obj 200 600 r send_2_3;
#X obj 20 630 r send_3_0;
#X obj 80 630 r send_3_1;
#X obj 140 630 r send_3_2;
#X obj 200 630 r send_3_3;
#N canvas 0 0 800 600 fx_chain 0;
#X obj 20 30 r~ master_in;
#X obj 20 60 *~ 1;
#X obj 20 100 rev3~ 70 50 50 0.6;
#X obj 20 160 +~;
#X obj 200 30 r~ master_dry;
