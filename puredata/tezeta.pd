#N canvas 80 80 1200 800 10;
#X text 20 10 tezeta -- Ethiopian-mode synth engine. Pi only audio. Web only control.;
#X text 20 30 Receives: mode (1=tezeta 2=bati 3=ambassel 4=anchihoye) \, root (Hz) \, gate_<v> \, pitch_<v> \, send_<v>_<b> \, master \, rev_mix \, rev_size \, del_time \, del_fb \, bpm \, drum_on \, drum_step.;
#X obj 20 60 r mode;
#X obj 20 80 r root;
#X obj 80 60 r master;
#X obj 130 60 r rev_mix;
#X obj 200 60 r rev_size;
#X obj 280 60 r del_time;
#X obj 360 60 r del_fb;
#X obj 430 60 r bpm;
#X obj 490 60 r drum_on;
#X obj 560 60 r drum_step;
