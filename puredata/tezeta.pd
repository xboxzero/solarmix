#X obj 20 340 dac~ 1 2;
#X obj 350 60 r master_vol;
#X obj 350 90 lop 30;
#X obj 350 120 line~;
#X obj 350 30 t f;
#X text 400 30 master volume smoothing line~;
#X connect 0 0 2 0;
#X connect 0 0 4 0;
